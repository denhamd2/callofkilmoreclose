[node name="Car" type="RigidBody3D"]
; vehicle / world. Off layer 1 so the suspension RayCast3Ds (mask 1, world only)
; stop treating pedestrians as road surface — and so the car does not drive up its
; own runtime bumper spheres, which the rays do not exclude.
collision_layer = 8
collision_mask = 1
; Contact reporting for running people over — see Car._check_pedestrian_impacts().
; Five shapes report (the hull plus Pogo's four bumper spheres), hence the headroom.
contact_monitor = true
max_contacts_reported = 12
mass = 1280.0
physics_material_override = SubResource("PhysicsMaterial_car")
gravity_scale = 1.5
center_of_mass_mode = 1
center_of_mass = Vector3(0.05, -0.3, 0)
linear_damp_mode = 1
linear_damp = 0.35
angular_damp_mode = 1
angular_damp = 1.0
script = ExtResource("1_car")
transmission_mode = 1
load_transfer_factor = 1.5
speed_threshold = 18.0

; The glTF axis correction lives in golf_mk4_visual.tscn so the five parked cars in
; street_builder.gd inherit it too. All that is left here is ride height, and it is
; GEOMETRIC rather than tuned: the visual's wheel centres sit at y 0.28 in its own
; space, and Pogo's suspension carries the wheel centres at body-local -0.378, so
; the visual hangs 0.658 below the body origin and the two agree at any ride
; height. The old -0.12 was calibrated against the parked body height alone, so the
; whole car floated 0.57 m in the air the moment the suspension took over.
[node name="Mesh" parent="." instance=ExtResource("7_mesh")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.658, 0)

